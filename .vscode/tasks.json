{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Configure AMS",
            "type": "shell",
            "command": "cmake",
            "args": [
                "."
            ],
            "presentation": {
                "reveal": "always",
                "revealProblems": "onProblem",
                "echo": true,
                "panel": "new",
                "showReuseMessage": false,
                "close": false
            },
            "problemMatcher": [
                {
                    "owner": "cmake",
                    "fileLocation": "relative",
                    "pattern": [
                        {
                            "regexp": "^CMake (Error|Warning|Deprecation Warning|Author Warning) at (.*):([0-9]+) \\(([^)]+)\\):$",
                            "severity": 1,
                            "file": 2,
                            "line": 3
                        },
                        {
                            "regexp": "^  (.*)$",
                            "message": 1
                        }
                    ]
                }
            ]
        },
        {
            "label": "Build AMS",
            "type": "shell",
            "command": "make",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "dependsOn": [
                "Configure AMS"
            ],
            "presentation": {
                "reveal": "always",
                "revealProblems": "onProblem",
                "echo": true,
                "panel": "new",
                "showReuseMessage": false,
                "close": false
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "Clean AMS",
            "type": "shell",
            "command": "${workspaceFolder}/CMakeClean.sh",
            "args": [
                "deep"
            ],
            "presentation": {
                "reveal": "always",
                "revealProblems": "onProblem",
                "echo": true,
                "panel": "new",
                "showReuseMessage": false,
                "close": false
            },
            "problemMatcher": []
        }
    ]
}
